# Copy to .env locally. Never commit real credentials.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/paisa
SPRING_DATASOURCE_USERNAME=paisa_app
SPRING_DATASOURCE_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SECURE_COOKIES=false
# Email verification. Use an app password for Gmail, never your Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
