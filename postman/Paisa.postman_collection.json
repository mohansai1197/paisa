{
  "info": {
    "name": "Paisa API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use a fictional review account. Set email/password locally. Cookie jar must remain enabled. Run Workspace to capture IDs before transaction requests. Destructive requests remove only the test IDs captured by this collection. AI routes need a backend Gemini key."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "email",
      "value": "review@example.test"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "month",
      "value": "2026-11"
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "budgetId",
      "value": ""
    },
    {
      "key": "verificationCode",
      "value": ""
    },
    {
      "key": "resetCode",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (['POST', 'PUT', 'DELETE'].includes(pm.request.method)) {",
          "  pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/api/auth/csrf', (err, response) => {",
          "    if (err || response.code !== 200) throw new Error('Could not obtain CSRF token');",
          "    const csrf = response.json();",
          "    pm.request.headers.upsert({key: csrf.headerName, value: csrf.token});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/status"
      }
    },
    {
      "name": "Register pending workspace (sends verification email)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Paisa Review\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Requires a configured SMTP sender. Returns 202 without signing in. Use a real address you own; then set verificationCode from its inbox. Test fixtures use a mocked sender."
      }
    },
    {
      "name": "Verify email (enter code from inbox)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/verify",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Resend verification (60-second cooldown)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/resend-verification",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Forgot password (email code)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/forgot-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Reset password (consumes code, revokes sessions)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/reset-password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{resetCode}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Workspace and IDs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/workspace"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Workspace loaded', () => pm.response.to.have.status(200));",
              "const w = pm.response.json();",
              "if (w.accounts.length) pm.collectionVariables.set('accountId', w.accounts[0].id);",
              "const c = w.categories.find(c => c.type === 'EXPENSE');",
              "if (c) pm.collectionVariables.set('categoryId', c.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Add account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Review cash\",\n  \"type\": \"CASH\",\n  \"openingBalance\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('accountId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update account",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Review cash\",\n  \"type\": \"CASH\",\n  \"openingBalance\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "New category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Review expenses\",\n  \"type\": \"EXPENSE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Add transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/transactions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"type\": \"EXPENSE\",\n  \"description\": \"Coffee for the fictional demo\",\n  \"amount\": 125.25,\n  \"date\": \"2026-11-21\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('transactionId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Edit transaction",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/transactions/{{transactionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"type\": \"EXPENSE\",\n  \"description\": \"Coffee for the fictional demo\",\n  \"amount\": 150,\n  \"date\": \"2026-11-21\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Set monthly budget",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/budgets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"month\": \"{{month}}\",\n  \"limitAmount\": 300\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('budgetId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Monthly analytics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/analytics?month={{month}}"
      }
    },
    {
      "name": "Monthly CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reports?month={{month}}"
      }
    },
    {
      "name": "AI expense categorization (requires configured Gemini)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ai/categorize",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Coffee with friends\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "AI patterns, budgets and summary (requires configured Gemini)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/ai/monthly?month={{month}}"
      }
    },
    {
      "name": "Delete test transaction",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
      }
    },
    {
      "name": "Delete test budget",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/budgets/{{budgetId}}"
      }
    },
    {
      "name": "Sign out",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/auth/logout"
      }
    }
  ]
}
