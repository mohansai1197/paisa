  ACCOUNTS {
    bigint id PK
    bigint owner_id FK
    varchar name
    varchar type
    decimal opening_balance
  }
  CATEGORIES {
    bigint id PK
    bigint owner_id FK
    varchar name
    varchar type
    varchar color
  }
  TRANSACTIONS {
    bigint id PK
    bigint owner_id FK
    bigint account_id FK
    bigint category_id FK
    varchar type
    varchar description
