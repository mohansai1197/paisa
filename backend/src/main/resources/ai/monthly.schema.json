{
  "type": "object",
  "properties": {
    "summary": {"type": "string", "maxLength": 2400},
    "patterns": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {"title": {"type": "string", "maxLength": 100}, "detail": {"type": "string", "maxLength": 1200}},
        "required": ["title", "detail"], "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array", "minItems": 0, "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {"categoryId": {"type": "integer"}, "suggestedLimit": {"type": "number"}, "reason": {"type": "string", "maxLength": 1200}},
        "required": ["categoryId", "suggestedLimit", "reason"], "additionalProperties": false
      }
    }
  },
  "required": ["summary", "patterns", "recommendations"],
  "additionalProperties": false
}
